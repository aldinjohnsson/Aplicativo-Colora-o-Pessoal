# ── Front (Vite) — TUDO aqui vai pro bundle público ─────────────
# Jamais colocar segredos com prefixo VITE_

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Liga o proxy Gemini (chave Gemini fica server-side)
VITE_USE_GEMINI_PROXY=true

# ── Servidor (Supabase Edge Functions) ──────────────────────────
# Configurar com: supabase secrets set NOME=valor
# (Não colocar aqui no .env do front)
#
#   GOOGLE_OAUTH_CLIENT_ID
#   GOOGLE_OAUTH_CLIENT_SECRET
#   CLEANUP_SECRET
#   SITE_URL